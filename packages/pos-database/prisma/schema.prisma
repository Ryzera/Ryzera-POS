generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleStatus {
  Pending
  Completed
  Cancelled
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
}

enum PaymentMethod {
  Cash
  Card
  Split
}

enum ReturnType {
  Full
  Partial
}

enum RefundMethod {
  Cash
  Card
  Wallet
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("branch_status")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED

  @@map("product_status")
}

enum UnitOfMeasure {
  PCS
  KG
  PACK
  LTR
  BOX
  MTR

  @@map("unit_of_measure")
}

enum InventoryAction {
  CREATE
  UPDATE
  SALE
  RESTOCK
  DELETE
  TRANSFER
  ADJUSTMENT
  STOCK_TAKE
  RETURN_FROM_CUSTOMER
  RETURN_TO_SUPPLIER
  WASTE_DAMAGED

  @@map("inventory_action")
}

enum AlertStatus {
  PENDING
  SEEN
  RESOLVED

  @@map("alert_status")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED

  @@map("invoice_status")
}

enum TransferStatus {
  PENDING
  SHIPPED
  RECEIVED
  CANCELLED

  @@map("transfer_status")
}

enum SettingScope {
  GLOBAL
  BRANCH
}

//  SECTION 1 — BILLING TABLES

model ryzera_pos_sale {
  sale_id         Int        @id @default(autoincrement())
  sale_date       DateTime   @default(now())
  invoice_number  String     @unique
  sale_status     SaleStatus
  payment_status  String
  subtotal        Float
  discount_amount Float
  tax_amount      Float
  total_amount    Float
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  branchId   Int?
  branch     Branch?                @relation(fields: [branchId], references: [branchId])
  sale_items ryzera_pos_sale_item[] @relation("SaleToItems")
  payments   ryzera_pos_payment[]   @relation("SaleToPayments")
  returns    ryzera_pos_return[]    @relation("SaleToReturns")
}

model ryzera_pos_sale_item {
  sale_item_id     Int      @id @default(autoincrement())
  product_name     String
  quantity         Float
  unit             String
  unit_price       Float
  cost_price       Float
  discount_percent Float
  discount_amount  Float
  tax_percent      Float
  tax_amount       Float
  subtotal         Float
  total_amount     Float
  created_at       DateTime @default(now())

  saleId    Int
  productId String?
  sale      ryzera_pos_sale @relation("SaleToItems", fields: [saleId], references: [sale_id])
  product   InvProduct?     @relation(fields: [productId], references: [id])

  return_items ryzera_pos_return_item[]
}

model ryzera_pos_payment {
  payment_id            Int           @id @default(autoincrement())
  payment_method        PaymentMethod
  amount_paid           Float
  payment_status        PaymentStatus
  transaction_reference String?
  payment_date          DateTime      @default(now())
  created_at            DateTime      @default(now())

  saleId Int
  sale   ryzera_pos_sale @relation("SaleToPayments", fields: [saleId], references: [sale_id])
}

model ryzera_pos_return {
  return_id     Int          @id @default(autoincrement())
  return_date   DateTime     @default(now())
  return_type   ReturnType
  return_amount Float
  reason        String
  refund_method RefundMethod
  status        String
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  saleId Int
  sale   ryzera_pos_sale @relation("SaleToReturns", fields: [saleId], references: [sale_id])

  return_items ryzera_pos_return_item[]
}

model ryzera_pos_return_item {
  return_item_id    Int      @id @default(autoincrement())
  quantity_returned Float
  unit_price        Float
  refund_amount     Float
  item_condition    String
  created_at        DateTime @default(now())

  returnId   Int
  return     ryzera_pos_return    @relation(fields: [returnId], references: [return_id])
  saleItemId Int
  sale_item  ryzera_pos_sale_item @relation(fields: [saleItemId], references: [sale_item_id])
}

//  SECTION 2 — AUTHENTICATION & USER TABLES

model Company {
  company_id Int      @id @default(autoincrement())
  name       String
  code       String   @unique
  email      String?
  phone      String?
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  branches Branch[]
  users    User[]

  @@map("ryzera_pos_company")
}

model Branch {
  branchId   Int      @id @default(autoincrement())
  company_id Int
  name       String
  code       String
  address    String?
  city       String?
  phone      String?
  email      String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company        Company           @relation(fields: [company_id], references: [company_id])
  users          User[]
  userLogs       UserLog[]
  sales          ryzera_pos_sale[]
  dailySummaries DailySummary[]

  @@map("ryzera_pos_branch")
}

model User {
  user_id    Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  status     String
  company_id Int
  branch_id  Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // ── Relations ──────────────────────────────────────────────────
  company       Company            @relation(fields: [company_id], references: [company_id])
  branch        Branch             @relation(fields: [branch_id], references: [branchId])
  info          UserInfo?
  userRoles     UserRole[]
  logs          UserLog[]
  inventoryLogs AuthInventoryLog[]

  // ── Reports Hub back-relations ─────────────────────────────────
  savedReportConfigs SavedReportConfig[]
  reportSchedules    ReportSchedule[]
  auditLogs          AuditLog[]

  @@map("ryzera_pos_user")
}

model UserInfo {
  user_info_id Int      @id @default(autoincrement())
  user_id      Int      @unique
  first_name   String
  last_name    String
  email        String?  @unique
  phone        String?
  address      String?
  profile_pic  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("ryzera_pos_user_info")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  roleAuthorities RoleAuthority[]

  @@map("ryzera_pos_role")
}

model Authority {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roleAuthorities RoleAuthority[]

  @@map("ryzera_pos_authority")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    Int
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("ryzera_pos_user_role")
}

model RoleAuthority {
  id          String   @id @default(uuid())
  roleId      String
  authorityId String
  createdAt   DateTime @default(now())

  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  authority Authority @relation(fields: [authorityId], references: [id], onDelete: Cascade)

  @@unique([roleId, authorityId])
  @@map("ryzera_pos_role_authority")
}

model UserLog {
  id        String   @id @default(uuid())
  userId    Int
  branch_id Int
  action    String
  ipAddress String?
  userAgent String?
  status    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  branch Branch @relation(fields: [branch_id], references: [branchId])

  @@map("ryzera_pos_user_log")
}

model AuthProduct {
  id            String             @id @default(uuid())
  name          String
  price         Float
  stockQty      Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  inventoryLogs AuthInventoryLog[]

  @@map("ryzera_pos_product")
}

model AuthInventoryLog {
  id          String   @id @default(uuid())
  action      String
  changeQty   Int
  description String?
  userId      Int
  productId   String
  createdAt   DateTime @default(now())

  user    User        @relation(fields: [userId], references: [user_id])
  product AuthProduct @relation(fields: [productId], references: [id])

  @@map("ryzera_pos_inventory_log")
}

model AuthSyncLog {
  id        String   @id @default(uuid())
  entity    String
  status    String
  payload   Json
  createdAt DateTime @default(now())

  @@map("ryzera_pos_sync_log")
}

//  SECTION 3 — REPORTING TABLES

model DailySummary {
  id                String   @id @default(uuid())
  summaryDate       DateTime
  totalSales        Float    @default(0)
  totalTransactions Int      @default(0)
  totalItemsSold    Int      @default(0)
  totalDiscounts    Float    @default(0)
  totalTax          Float    @default(0)
  grossProfit       Float    @default(0)
  totalReturns      Float    @default(0)
  totalCost         Float    @default(0)
  totalCustomers    Int      @default(0)
  netProfit         Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [branchId])

  @@unique([summaryDate, branchId])
}

model ryzera_pos_scheduled_report {
  id            Int      @id @default(autoincrement())
  report_name   String
  report_type   String
  frequency     String
  start_date    DateTime
  next_run_date DateTime
  email         String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  branch_id       Int?
  type            String
  title           String
  message         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  @@map("ryzera_pos_notification")
}

model KpiTarget {
  kpi_id        Int     @id @default(autoincrement())
  branch_id     Int     @default(0) // 0 = all branches
  period_type   String // "Daily" | "Weekly" | "Monthly"
  target_amount Decimal @db.Decimal(12, 2)

  @@unique([period_type, branch_id])
  @@map("ryzera_pos_kpi_target")
}

// ─── Reports Hub: Saved Configurations ───────────────────────────

model SavedReportConfig {
  id         String   @id @default(uuid())
  configName String   @db.VarChar(100)
  reportType String   @db.VarChar(50)
  startDate  String   @db.VarChar(10) // YYYY-MM-DD
  endDate    String   @db.VarChar(10) // YYYY-MM-DD
  branchId   Int? // null = "All Branches"
  categoryId String?  @db.VarChar(36) // null = "All Categories"
  userId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_report_configs")
}

// ─── Reports Hub: Automated Schedules ────────────────────────────
model ReportSchedule {
  id             String    @id @default(uuid())
  scheduleName   String    @db.VarChar(100)
  reportType     String    @db.VarChar(50)
  frequency      String    @db.VarChar(20) // DAILY | WEEKLY | MONTHLY
  recipientEmail String    @db.VarChar(255)
  branchId       Int?
  categoryId     String?   @db.VarChar(36)
  isActive       Boolean   @default(true)
  nextRunAt      DateTime?
  userId         Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User             @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  deliveries ReportDelivery[]

  @@index([userId])
  @@index([isActive, nextRunAt]) // used by the cron job query
  @@map("report_schedules")
}

// ─── Reports Hub: Delivery History ───────────────────────────────
model ReportDelivery {
  id             String   @id @default(uuid())
  recipientEmail String   @db.VarChar(255)
  status         String   @db.VarChar(20) // PENDING | DELIVERED | FAILED
  failureReason  String?  @db.Text
  reportFileUrl  String?  @db.VarChar(500)
  sentAt         DateTime @default(now())

  scheduleId String
  schedule   ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("report_deliveries")
}

model KpiMarginTarget {
  id                  Int     @id @default(autoincrement())
  branch_id           Int     @default(0)
  target_gross_margin Decimal @db.Decimal(5, 2) // e.g. 38.00 = 38%
  target_net_margin   Decimal @db.Decimal(5, 2) // e.g. 32.00 = 32%

  @@unique([branch_id])
  @@map("ryzera_pos_kpi_margin_target")
}

model KpiInventoryThreshold {
  id                    Int @id @default(autoincrement())
  branch_id             Int @default(0)
  default_reorder_level Int @default(20) // reorder alert fires when stock < this
  critical_stock_level  Int @default(5) // urgent alert level
  zero_sales_hours      Int @default(24) // hours with no product sales before alert

  @@unique([branch_id])
  @@map("ryzera_pos_kpi_inventory_threshold")
}

model KpiNotificationRule {
  id                         Int     @id @default(autoincrement())
  branch_id                  Int     @default(0)
  daily_target_midday        Boolean @default(true)
  unusual_hourly_drop        Boolean @default(true)
  zero_sales_product         Boolean @default(true)
  low_stock_alert            Boolean @default(true)
  out_of_stock_alert         Boolean @default(true)
  daily_summary_notification Boolean @default(true)
  weekly_performance_summary Boolean @default(false) // OFF by default (matches UI)
  margin_below_target        Boolean @default(true) // ON by default (matches UI)
  check_frequency_minutes    Int     @default(5) // 1 | 5 | 10 | 30 | 60

  @@unique([branch_id])
  @@map("ryzera_pos_kpi_notification_rule")
}

model KpiReportDefault {
  id                   Int     @id @default(autoincrement())
  branch_id            Int     @default(0)
  default_date_range   String  @default("LAST_30_DAYS")
  // Accepted values: LAST_7_DAYS | LAST_30_DAYS | LAST_90_DAYS | THIS_MONTH | CUSTOM
  default_branch_view  String  @default("ALL")
  // Accepted values: ALL | <branch_id as string>
  show_target_progress Boolean @default(true)

  @@unique([branch_id])
  @@map("ryzera_pos_kpi_report_default")
}

model AuditLog {
  id String @id @default(uuid())

  /// Username of the user who performed the action
  username String @db.VarChar(100)

  /// Role label at the time of the action (e.g. "Branch Mgr", "Super Admin")
  role String @db.VarChar(50)

  /// "Generated" | "Exported PDF" | "Exported CSV"
  action String @db.VarChar(30)

  /// Report type label (e.g. "Sales Report", "P&L Summary")
  reportType String @db.VarChar(50)

  /// Human-readable filter summary (e.g. "Feb 1–28, Dairy")
  filtersUsed String @db.VarChar(200)

  /// Branch name at time of action, or "All"
  branchName String @db.VarChar(100)

  /// Foreign key back to the user — kept for joins but not strictly required
  userId Int

  /// Timestamp of the action (stored in UTC)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

//  SECTION 4 — INVENTORY TABLES

model InvBranch {
  id      String       @id @default(uuid())
  name    String
  address String?
  phone   String?
  status  BranchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          InvUser[]
  branchProducts BranchProduct[]
  inventoryLogs  InvInventoryLog[]
  stockAlerts    StockAlert[]
  purchaseOrders PurchaseOrder[]
  transfersFrom  Transfer[]        @relation("TransferSource")
  transfersTo    Transfer[]        @relation("TransferDestination")

  @@map("branch")
}

model InvUser {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  branchId String?
  branch   InvBranch? @relation(fields: [branchId], references: [id])

  inventoryLogs  InvInventoryLog[]
  purchaseOrders PurchaseOrder[]
  transfers      Transfer[]

  @@map("user")
}

model Supplier {
  id           String  @id @default(uuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  leadTimeDays Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       InvProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("supplier")
}

model Category {
  id       String       @id @default(uuid())
  name     String       @unique
  products InvProduct[]

  @@map("category")
}

model InvProduct {
  id          String        @id @default(uuid())
  name        String
  sku         String        @unique
  barcode     String?       @unique
  description String?
  price       Decimal       @db.Decimal(12, 4)
  costPrice   Decimal?      @db.Decimal(12, 4)
  minStock    Int           @default(5)
  unit        UnitOfMeasure @default(PCS)
  status      ProductStatus @default(ACTIVE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchProducts     BranchProduct[]
  inventoryLogs      InvInventoryLog[]
  stockAlerts        StockAlert[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      TransferItem[]
  batches            Batch[]
  sale_items         ryzera_pos_sale_item[]

  @@map("product")
}

model BranchProduct {
  id          String @id @default(uuid())
  stockQty    Int    @default(0)
  reservedQty Int    @default(0)

  branchId  String
  branch    InvBranch  @relation(fields: [branchId], references: [id])
  productId String
  product   InvProduct @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLogs InvInventoryLog[]

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_product")
}

model InvInventoryLog {
  id          String          @id @default(uuid())
  action      InventoryAction
  changeQty   Int
  description String?

  userId          String
  user            InvUser       @relation(fields: [userId], references: [id])
  productId       String
  product         InvProduct    @relation(fields: [productId], references: [id])
  branchId        String
  branch          InvBranch     @relation(fields: [branchId], references: [id])
  branchProductId String
  branchProduct   BranchProduct @relation(fields: [branchProductId], references: [id])

  createdAt DateTime @default(now())

  @@index([branchProductId])
  @@map("inventory_log")
}

model StockAlert {
  id       String      @id @default(uuid())
  status   AlertStatus @default(PENDING)
  stockQty Int
  minStock Int

  productId String
  product   InvProduct @relation(fields: [productId], references: [id])
  branchId  String
  branch    InvBranch  @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder?

  @@index([status])
  @@index([productId, branchId])
  @@map("stock_alert")
}

model PurchaseOrder {
  id     String              @id @default(uuid())
  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  branchId   String
  branch     InvBranch @relation(fields: [branchId], references: [id])

  createdById  String
  createdBy    InvUser     @relation(fields: [createdById], references: [id])
  stockAlertId String?     @unique
  stockAlert   StockAlert? @relation(fields: [stockAlertId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   PurchaseOrderItem[]
  invoice Invoice?

  @@index([supplierId])
  @@index([branchId])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitCost  Decimal @db.Decimal(12, 4)
  totalCost Decimal @db.Decimal(12, 4)

  productId       String
  product         InvProduct    @relation(fields: [productId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_item")
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique
  status      InvoiceStatus @default(UNPAID)
  totalAmount Decimal       @db.Decimal(12, 4)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?

  purchaseOrderId String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice")
}

model Transfer {
  id     String         @id @default(uuid())
  status TransferStatus @default(PENDING)
  notes  String?

  sourceBranchId      String
  sourceBranch        InvBranch @relation("TransferSource", fields: [sourceBranchId], references: [id])
  destinationBranchId String
  destinationBranch   InvBranch @relation("TransferDestination", fields: [destinationBranchId], references: [id])

  createdById String
  createdBy   InvUser @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TransferItem[]

  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@map("transfer")
}

model TransferItem {
  id       String @id @default(uuid())
  quantity Int

  productId  String
  product    InvProduct @relation(fields: [productId], references: [id])
  transferId String
  transfer   Transfer   @relation(fields: [transferId], references: [id])

  @@index([transferId])
  @@map("transfer_item")
}

model Batch {
  id              String    @id @default(uuid())
  batchNumber     String    @unique
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Int

  productId String
  product   InvProduct @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([expiryDate])
  @@map("batch")
}
