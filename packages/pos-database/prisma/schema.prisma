generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums (Sync Module)
// ─────────────────────────────────────────────

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  @@map("sync_status")
}

enum SyncSettingScope {
  GLOBAL
  BRANCH
  @@map("sync_setting_scope")
}

enum SyncBackupStatus {
  SUCCESS
  FAILED
  PARTIAL
  @@map("sync_backup_status")
}

// ─────────────────────────────────────────────
// Sync Company – groups branches under one company
// ─────────────────────────────────────────────

model SyncCompany {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  SyncBranch[]
  syncLogs  SyncLog[]
  settings  SyncSetting[]
  backups   SyncBackup[]

  @@index([code])
  @@map("sync_company")
}

// ─────────────────────────────────────────────
// Sync Branch – physical store location
// ─────────────────────────────────────────────

model SyncBranch {
  id         String   @id @default(uuid())
  companyId  String
  name       String
  code       String
  address    String?
  phone      String?
  adminEmail String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   SyncCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  syncLogs  SyncLog[]
  settings  SyncSetting[]
  backups   SyncBackup[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("sync_branch")
}

// ─────────────────────────────────────────────
// Sync Log – offline‑first queue
// ─────────────────────────────────────────────

model SyncLog {
  id        String        @id @default(uuid())
  companyId String?
  branchId  String?
  entity    String
  status    SyncStatus    @default(PENDING)
  payload   Json
  error     String?
  attempts  Int           @default(0)
  syncedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company   SyncCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    SyncBranch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([branchId, status])
  @@index([status])
  @@index([createdAt])
  @@map("sync_log")
}

// ─────────────────────────────────────────────
// Sync Setting – key‑value configuration
// ─────────────────────────────────────────────

model SyncSetting {
  id          String           @id @default(uuid())
  key         String
  value       String
  description String?
  scope       SyncSettingScope @default(GLOBAL)
  companyId   String
  branchId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   SyncCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    SyncBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, key])
  @@index([companyId])
  @@index([branchId])
  @@map("sync_setting")
}

// ─────────────────────────────────────────────
// Sync Backup – backup history
// ─────────────────────────────────────────────

model SyncBackup {
  id        String           @id @default(uuid())
  companyId String
  branchId  String?
  status    SyncBackupStatus @default(SUCCESS)
  fileName  String
  notes     String?
  createdAt DateTime         @default(now())

  company   SyncCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    SyncBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
  @@map("sync_backup")
}

// ============================================================
// Other tables (User, Product, Branch, etc.)
// ============================================================

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  @@map("branch_status")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  @@map("product_status")
}

enum UnitOfMeasure {
  PCS
  KG
  PACK
  LTR
  BOX
  MTR
  @@map("unit_of_measure")
}

enum InventoryAction {
  CREATE
  UPDATE
  SALE
  RESTOCK
  DELETE
  TRANSFER
  ADJUSTMENT
  STOCK_TAKE
  RETURN_FROM_CUSTOMER
  RETURN_TO_SUPPLIER
  WASTE_DAMAGED
  @@map("inventory_action")
}

enum AlertStatus {
  PENDING
  SEEN
  RESOLVED
  @@map("alert_status")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
  @@map("purchase_order_status")
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
  @@map("invoice_status")
}

enum TransferStatus {
  PENDING
  SHIPPED
  RECEIVED
  CANCELLED
  @@map("transfer_status")
}

model Branch {
  id      String       @id @default(uuid())
  name    String
  address String?
  phone   String?
  status  BranchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  branchProducts BranchProduct[]
  inventoryLogs  InventoryLog[]
  stockAlerts    StockAlert[]
  purchaseOrders PurchaseOrder[]
  transfersFrom  Transfer[] @relation("TransferSource")
  transfersTo    Transfer[] @relation("TransferDestination")

  @@map("branch")
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  inventoryLogs  InventoryLog[]
  purchaseOrders PurchaseOrder[]
  transfers      Transfer[]

  @@map("user")
}

model Supplier {
  id          String  @id @default(uuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?

  leadTimeDays Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("supplier")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("category")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  sku         String        @unique
  barcode     String?       @unique
  description String?
  price       Decimal       @db.Decimal(12, 4)
  costPrice   Decimal?      @db.Decimal(12, 4)
  minStock    Int           @default(5)
  unit        UnitOfMeasure @default(PCS)
  status      ProductStatus @default(ACTIVE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchProducts     BranchProduct[]
  inventoryLogs      InventoryLog[]
  stockAlerts        StockAlert[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      TransferItem[]
  batches            Batch[]

  @@map("product")
}

model BranchProduct {
  id          String @id @default(uuid())
  stockQty    Int    @default(0)
  reservedQty Int    @default(0)

  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLogs InventoryLog[]

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_product")
}

model InventoryLog {
  id          String          @id @default(uuid())
  action      InventoryAction
  changeQty   Int
  description String?

  userId          String
  user            User          @relation(fields: [userId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  branchProductId String
  branchProduct   BranchProduct @relation(fields: [branchProductId], references: [id])

  createdAt DateTime @default(now())

  @@index([branchProductId])
  @@map("inventory_log")
}

model StockAlert {
  id       String      @id @default(uuid())
  status   AlertStatus @default(PENDING)
  stockQty Int
  minStock Int

  productId String
  product   Product @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder?

  @@index([status])
  @@index([productId, branchId])
  @@map("stock_alert")
}

model PurchaseOrder {
  id     String              @id @default(uuid())
  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  stockAlertId String?     @unique
  stockAlert   StockAlert? @relation(fields: [stockAlertId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   PurchaseOrderItem[]
  invoice Invoice?

  @@index([supplierId])
  @@index([branchId])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitCost  Decimal @db.Decimal(12, 4)
  totalCost Decimal @db.Decimal(12, 4)

  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_item")
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique
  status      InvoiceStatus @default(UNPAID)
  totalAmount Decimal       @db.Decimal(12, 4)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?

  purchaseOrderId String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice")
}

model Transfer {
  id     String         @id @default(uuid())
  status TransferStatus @default(PENDING)
  notes  String?

  sourceBranchId      String
  sourceBranch        Branch @relation("TransferSource", fields: [sourceBranchId], references: [id])
  destinationBranchId String
  destinationBranch   Branch @relation("TransferDestination", fields: [destinationBranchId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TransferItem[]

  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@map("transfer")
}

model TransferItem {
  id       String @id @default(uuid())
  quantity Int

  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id])

  @@index([transferId])
  @@map("transfer_item")
}

model Batch {
  id              String    @id @default(uuid())
  batchNumber     String    @unique
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Int

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([expiryDate])
  @@map("batch")
}