generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

enum SaleStatus {
  Pending
  Completed
  Cancelled
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
}

enum PaymentMethod {
  Cash
  Card
  Split
}

enum ReturnType {
  Full
  Partial
}

enum RefundMethod {
  Cash
  Card
  Wallet
}

enum ReturnStatus {
  Pending
  Completed
  Rejected
}

model ryzera_pos_sale {
  sale_id         Int           @id @default(autoincrement())
  branch_id       String
  user_id         String
  sale_date       DateTime      @default(now())
  invoice_number  String        @unique
  sale_status     SaleStatus    @default(Pending)
  payment_status  PaymentStatus @default(Pending)
  subtotal        Decimal       @default(0) @db.Decimal(10, 2)
  discount_amount Decimal       @default(0) @db.Decimal(10, 2)
  tax_amount      Decimal       @default(0) @db.Decimal(10, 2)
  total_amount    Decimal       @default(0) @db.Decimal(10, 2)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  sale_items ryzera_pos_sale_item[] @relation("SaleToItems")
  payments   ryzera_pos_payment[]   @relation("SaleToPayments")
  returns    ryzera_pos_return[]    @relation("SaleToReturns")
}

model ryzera_pos_sale_item {
  sale_item_id     Int      @id @default(autoincrement())
  product_id       String
  product_name     String
  quantity         Decimal  @db.Decimal(10, 2)
  unit             String
  unit_price       Decimal  @db.Decimal(10, 2)
  cost_price       Decimal  @db.Decimal(10, 2)
  discount_percent Decimal  @default(0) @db.Decimal(5, 2)
  discount_amount  Decimal  @default(0) @db.Decimal(10, 2)
  tax_percent      Decimal  @default(0) @db.Decimal(5, 2)
  tax_amount       Decimal  @default(0) @db.Decimal(10, 2)
  subtotal         Decimal  @db.Decimal(10, 2)
  total_amount     Decimal  @db.Decimal(10, 2)
  created_at       DateTime @default(now())

  saleId       Int
  sale         ryzera_pos_sale          @relation("SaleToItems", fields: [saleId], references: [sale_id])
  return_items ryzera_pos_return_item[]
}

model ryzera_pos_payment {
  payment_id            Int           @id @default(autoincrement())
  payment_method        PaymentMethod
  amount_paid           Decimal       @db.Decimal(10, 2)
  payment_status        PaymentStatus @default(Pending)
  transaction_reference String?
  payment_date          DateTime      @default(now())
  created_at            DateTime      @default(now())

  saleId Int
  sale   ryzera_pos_sale @relation("SaleToPayments", fields: [saleId], references: [sale_id])
}

model ryzera_pos_return {
  return_id     Int          @id @default(autoincrement())
  return_date   DateTime     @default(now())
  return_type   ReturnType
  return_amount Decimal      @db.Decimal(10, 2)
  reason        String
  refund_method RefundMethod
  status        ReturnStatus @default(Pending)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  saleId Int
  sale   ryzera_pos_sale @relation("SaleToReturns", fields: [saleId], references: [sale_id])

  return_items ryzera_pos_return_item[]
}

model ryzera_pos_return_item {
  return_item_id    Int      @id @default(autoincrement())
  quantity_returned Decimal  @db.Decimal(10, 2)
  unit_price        Decimal  @db.Decimal(10, 2)
  refund_amount     Decimal  @db.Decimal(10, 2)
  item_condition    String
  created_at        DateTime @default(now())

  returnId   Int
  return     ryzera_pos_return    @relation(fields: [returnId], references: [return_id])
  saleItemId Int
  sale_item  ryzera_pos_sale_item @relation(fields: [saleItemId], references: [sale_item_id])
}


