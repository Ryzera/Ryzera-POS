generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model batch {
  id              String    @id
  batchNumber     String    @unique
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Int
  productId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  product         product   @relation(fields: [productId], references: [id])

  @@index([expiryDate])
  @@index([productId])
}

model branch {
  id                                            String           @id
  name                                          String
  address                                       String?
  phone                                         String?
  status                                        branch_status    @default(ACTIVE)
  createdAt                                     DateTime         @default(now())
  updatedAt                                     DateTime
  branch_product                                branch_product[]
  inventory_log                                 inventory_log[]
  purchase_order                                purchase_order[]
  stock_alert                                   stock_alert[]
  transfer_transfer_destinationBranchIdTobranch transfer[]       @relation("transfer_destinationBranchIdTobranch")
  transfer_transfer_sourceBranchIdTobranch      transfer[]       @relation("transfer_sourceBranchIdTobranch")
  user                                          user[]
}

model branch_product {
  id            String          @id
  stockQty      Int             @default(0)
  reservedQty   Int             @default(0)
  branchId      String
  productId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  branch        branch          @relation(fields: [branchId], references: [id])
  product       product         @relation(fields: [productId], references: [id])
  inventory_log inventory_log[]

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model category {
  id      String    @id
  name    String    @unique
  product product[]
}

model inventory_log {
  id              String           @id
  action          inventory_action
  changeQty       Int
  description     String?
  userId          String
  productId       String
  branchId        String
  branchProductId String
  createdAt       DateTime         @default(now())
  branch          branch           @relation(fields: [branchId], references: [id])
  branch_product  branch_product   @relation(fields: [branchProductId], references: [id])
  product         product          @relation(fields: [productId], references: [id])
  user            user             @relation(fields: [userId], references: [id])

  @@index([branchProductId])
}

model invoice {
  id              String         @id
  invoiceNo       String         @unique
  status          invoice_status @default(UNPAID)
  totalAmount     Decimal        @db.Decimal(12, 4)
  issuedAt        DateTime       @default(now())
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?
  purchaseOrderId String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  purchase_order  purchase_order @relation(fields: [purchaseOrderId], references: [id])
}

model product {
  id                  String                @id
  name                String
  sku                 String                @unique
  barcode             String?               @unique
  description         String?
  price               Decimal               @db.Decimal(12, 4)
  costPrice           Decimal?              @db.Decimal(12, 4)
  minStock            Int                   @default(5)
  unit                unit_of_measure       @default(PCS)
  status              product_status        @default(ACTIVE)
  categoryId          String?
  supplierId          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  batch               batch[]
  branch_product      branch_product[]
  inventory_log       inventory_log[]
  category            category?             @relation(fields: [categoryId], references: [id])
  supplier            supplier?             @relation(fields: [supplierId], references: [id])
  purchase_order_item purchase_order_item[]
  stock_alert         stock_alert[]
  transfer_item       transfer_item[]
}

model purchase_order {
  id                  String                @id
  status              purchase_order_status @default(DRAFT)
  notes               String?
  supplierId          String
  branchId            String
  createdById         String
  stockAlertId        String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  invoice             invoice?
  branch              branch                @relation(fields: [branchId], references: [id])
  user                user                  @relation(fields: [createdById], references: [id])
  stock_alert         stock_alert?          @relation(fields: [stockAlertId], references: [id])
  supplier            supplier              @relation(fields: [supplierId], references: [id])
  purchase_order_item purchase_order_item[]

  @@index([branchId])
  @@index([supplierId])
}

model purchase_order_item {
  id              String         @id
  quantity        Int
  unitCost        Decimal        @db.Decimal(12, 4)
  totalCost       Decimal        @db.Decimal(12, 4)
  productId       String
  purchaseOrderId String
  product         product        @relation(fields: [productId], references: [id])
  purchase_order  purchase_order @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model stock_alert {
  id             String          @id
  status         alert_status    @default(PENDING)
  stockQty       Int
  minStock       Int
  productId      String
  branchId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  purchase_order purchase_order?
  branch         branch          @relation(fields: [branchId], references: [id])
  product        product         @relation(fields: [productId], references: [id])

  @@index([productId, branchId])
  @@index([status])
}

model supplier {
  id             String           @id
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  leadTimeDays   Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  product        product[]
  purchase_order purchase_order[]

  @@index([name])
}

model transfer {
  id                                          String          @id
  status                                      transfer_status @default(PENDING)
  notes                                       String?
  sourceBranchId                              String
  destinationBranchId                         String
  createdById                                 String
  createdAt                                   DateTime        @default(now())
  updatedAt                                   DateTime
  user                                        user            @relation(fields: [createdById], references: [id])
  branch_transfer_destinationBranchIdTobranch branch          @relation("transfer_destinationBranchIdTobranch", fields: [destinationBranchId], references: [id])
  branch_transfer_sourceBranchIdTobranch      branch          @relation("transfer_sourceBranchIdTobranch", fields: [sourceBranchId], references: [id])
  transfer_item                               transfer_item[]

  @@index([destinationBranchId])
  @@index([sourceBranchId])
}

model transfer_item {
  id         String   @id
  quantity   Int
  productId  String
  transferId String
  product    product  @relation(fields: [productId], references: [id])
  transfer   transfer @relation(fields: [transferId], references: [id])

  @@index([transferId])
}

model user {
  id             String           @id
  name           String
  email          String           @unique
  password       String
  role           user_role        @default(STAFF)
  branchId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  inventory_log  inventory_log[]
  purchase_order purchase_order[]
  transfer       transfer[]
  branch         branch?          @relation(fields: [branchId], references: [id])
}

enum alert_status {
  PENDING
  SEEN
  RESOLVED
}

enum branch_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum inventory_action {
  CREATE
  UPDATE
  SALE
  RESTOCK
  DELETE
  TRANSFER
  ADJUSTMENT
  STOCK_TAKE
  RETURN_FROM_CUSTOMER
  RETURN_TO_SUPPLIER
  WASTE_DAMAGED
}

enum invoice_status {
  UNPAID
  PAID
  CANCELLED
}

enum product_status {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum purchase_order_status {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum transfer_status {
  PENDING
  SHIPPED
  RECEIVED
  CANCELLED
}

enum unit_of_measure {
  PCS
  KG
  PACK
  LTR
  BOX
  MTR
}

enum user_role {
  ADMIN
  STAFF
}
