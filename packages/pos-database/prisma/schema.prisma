generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  }

// ENUMS

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum UserType {
  ADMIN
  STAFF

  @@map("user_type")
}

enum LogAction {
  LOGIN
  LOGOUT
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  ROLE_ASSIGNED
  PASSWORD_CHANGED

  @@map("log_action")
}

enum LogStatus {
  SUCCESS
  FAILED

  @@map("log_status")
}

enum BillStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  @@map("bill_status")
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  @@map("payment_method")
}

// COMPANY & BRANCH (MULTI-TENANT SUPPORT)

model Company {
  id          Int      @id @default(autoincrement()) @map("company_id")
  name        String
  code        String   @unique
  email       String?
  phone       String?
  address     String?
  is_active   Boolean  @default(true)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  branches    Branch[]
  users       User[]
  products Product[]
  bills Bill[]


  @@map("ryzera_pos_company")
}

model Branch {
  id           Int      @id @default(autoincrement()) @map("branch_id")
  company_id   Int
  name         String
  code         String
  address      String?
  phone        String?
  email        String?
  is_active    Boolean  @default(true)

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company      Company  @relation(fields: [company_id], references: [id])
  users        User[]
  logs         UserLog[]
  products Product[]
  bills Bill[]


  @@unique([company_id, code])
  @@map("ryzera_pos_branch")
}

//////////////////////////////////////////////////////
// USER MANAGEMENT
//////////////////////////////////////////////////////

model User {
  id           Int        @id @default(autoincrement()) @map("user_id")
  username     String     @unique
  password     String

  company_id   Int
  branch_id    Int?

  user_type    UserType   @default(STAFF)
  status       UserStatus @default(ACTIVE)

  failed_login_attempts Int        @default(0)
  last_failed_login     DateTime?
  account_locked_until  DateTime?
  last_login_at         DateTime?

  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  company      Company    @relation(fields: [company_id], references: [id])
  branch       Branch?    @relation(fields: [branch_id], references: [id])
  bills Bill[] @relation("CashierBills")

  info         UserInfo?
  userRoles    UserRole[]
  logs         UserLog[]


  @@map("ryzera_pos_user")
}

model UserInfo {
  id          Int     @id @default(autoincrement())
  user_id     Int     @unique

  first_name  String
  last_name   String
  email       String?
  phone_number       String?
  address         String?
  profile_picture String?

  user        User    @relation(fields: [user_id], references: [id])

  @@map("ryzera_pos_user_info")

}

// ROLE & PERMISSIONS (RBAC)

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique
  description String?

  userRoles   UserRole[]
  authorities RoleAuthority[]

  @@map("ryzera_pos_role")
}

model Authority {
  id          Int     @id @default(autoincrement()) @map("authority_id")
  name        String  @unique
  description String?

  roles       RoleAuthority[]

  @@map("ryzera_pos_authority")
}

model UserRole {
  id       Int @id @default(autoincrement())

  userId   Int
  roleId   Int

  user     User @relation(fields: [userId], references: [id])
  role     Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("ryzera_pos_user_role")
}

model RoleAuthority {
  id           Int @id @default(autoincrement())

  roleId       Int
  authorityId  Int

  role         Role       @relation(fields: [roleId], references: [id])
  authority    Authority  @relation(fields: [authorityId], references: [id])

  @@unique([roleId, authorityId])
  @@map("ryzera_pos_role_authority")
}

// AUDIT LOGS

model UserLog {
  id          Int       @id @default(autoincrement())

  userId      Int
  branch_id   Int?

  action      LogAction
  status      LogStatus

  ip_address  String?
  user_agent  String?
  device_info String?

  created_at  DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  branch      Branch?   @relation(fields: [branch_id], references: [id])



  @@map("ryzera_pos_user_log")
}

model Product {
  id          Int      @id @default(autoincrement()) @map("product_id")
  name        String
  code        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost_price  Decimal? @db.Decimal(10, 2)
  quantity    Int      @default(0)
  min_quantity Int     @default(0)
  company_id  Int
  branch_id   Int?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  billItems BillItem[]


  company Company  @relation(fields: [company_id], references: [id])
  branch  Branch?  @relation(fields: [branch_id], references: [id])

  @@map("ryzera_pos_product")
}


model Bill {
  id             Int           @id @default(autoincrement()) @map("bill_id")
  bill_number    String        @unique
  company_id     Int
  branch_id      Int
  cashier_id     Int
  status         BillStatus    @default(PENDING)
  payment_method PaymentMethod @default(CASH)
  subtotal       Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  company  Company   @relation(fields: [company_id], references: [id])
  branch   Branch    @relation(fields: [branch_id], references: [id])
  cashier User @relation("CashierBills", fields: [cashier_id], references: [id])
  items    BillItem[]

  @@map("ryzera_pos_bill")
}

model BillItem {
  id         Int     @id @default(autoincrement()) @map("bill_item_id")
  bill_id    Int
  product_id Int
  quantity   Int
  unit_price Decimal @db.Decimal(10, 2)
  total      Decimal @db.Decimal(10, 2)

  bill    Bill    @relation(fields: [bill_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("ryzera_pos_bill_item")
}