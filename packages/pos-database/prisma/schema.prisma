generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  company_id Int      @id @default(autoincrement())
  name       String
  code       String   @unique
  email      String?
  phone      String?
  address    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  branches   Branch[]
  users      User[]

  @@map("ryzera_pos_company")
}

model Branch {
  branchId     Int          @id @default(autoincrement())
  company_id   Int
  name         String
  code         String
  address      String?
  city         String?
  phone        String?
  email        String?
  manager_name String?
  is_active    Boolean      @default(true)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  company      Company      @relation(fields: [company_id], references: [company_id])
  stockAlerts  StockAlert[]
  users        User[]
  userLogs     UserLog[]

  @@map("ryzera_pos_branch")
}

model User {
  user_id               Int            @id @default(autoincrement())
  username              String         @unique
  password              String
  user_type             String         @default("STAFF")
  status                String
  company_id            Int
  branch_id             Int
  failed_login_attempts Int            @default(0)
  last_failed_login     DateTime?
  account_locked_until  DateTime?
  last_login_at         DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt
  inventoryLogs         InventoryLog[]
  branch                Branch         @relation(fields: [branch_id], references: [branchId])
  company               Company        @relation(fields: [company_id], references: [company_id])
  info                  UserInfo?
  logs                  UserLog[]
  userRoles             UserRole[]

  @@map("ryzera_pos_user")
}

model UserInfo {
  user_info_id Int      @id @default(autoincrement())
  user_id      Int      @unique
  first_name   String
  last_name    String
  email        String?  @unique
  phone        String?
  address      String?
  profile_pic  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("ryzera_pos_user_info")
}

model Role {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  createdAt       DateTime        @default(now())
  roleAuthorities RoleAuthority[]
  userRoles       UserRole[]

  @@map("ryzera_pos_role")
}

model Authority {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  createdAt       DateTime        @default(now())
  roleAuthorities RoleAuthority[]

  @@map("ryzera_pos_authority")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    Int
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("ryzera_pos_user_role")
}

model RoleAuthority {
  id          String    @id @default(uuid())
  roleId      String
  authorityId String
  createdAt   DateTime  @default(now())
  authority   Authority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, authorityId])
  @@map("ryzera_pos_role_authority")
}

model UserLog {
  id          String   @id @default(uuid())
  userId      Int
  branch_id   Int
  action      String
  ipAddress   String?
  device_info String?
  userAgent   String?
  status      String
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branch_id], references: [branchId])
  user        User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@map("ryzera_pos_user_log")
}

model Product {
  id            String         @id @default(uuid())
  name          String
  price         Float
  stockQty      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventoryLogs InventoryLog[]
  stockAlerts   StockAlert[]

  @@map("ryzera_pos_product")
}

model InventoryLog {
  id          String          @id @default(uuid())
  action      InventoryAction
  changeQty   Int
  description String?
  userId      Int
  productId   String
  createdAt   DateTime        @default(now())
  product     Product         @relation(fields: [productId], references: [id])
  user        User            @relation(fields: [userId], references: [user_id])

  @@map("ryzera_pos_inventory_log")
}

model StockAlert {
  id        String      @id @default(uuid())
  status    AlertStatus @default(PENDING)
  stockQty  Int
  minStock  Int
  productId String
  branchId  Int
  createdAt DateTime    @default(now())
  branch    Branch      @relation(fields: [branchId], references: [branchId])
  product   Product     @relation(fields: [productId], references: [id])

  @@map("ryzera_pos_stock_alert")
}

model SyncCompany {
  id        String        @id @default(uuid())
  name      String
  code      String?       @unique
  email     String?
  phone     String?
  address   String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  backups   SyncBackup[]
  branches  SyncBranch[]
  syncLogs  SyncLog[]
  settings  SyncSetting[]

  @@index([code])
  @@map("sync_company")
}

model SyncBranch {
  id         String               @id @default(uuid())
  companyId  String
  name       String
  code       String
  address    String?
  phone      String?
  adminEmail String?
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  backups    SyncBackup[]
  schedules  SyncBackupSchedule[]
  company    SyncCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  devices    SyncDevice[]
  metrics    SyncHealthMetric[]
  syncLogs   SyncLog[]
  settings   SyncSetting[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("sync_branch")
}

model SyncLog {
  id        String        @id @default(uuid())
  companyId String?
  branchId  String?
  entity    String
  payload   Json
  error     String?
  attempts  Int           @default(0)
  syncedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  status    String        @default("PENDING")
  conflict  SyncConflict?
  branch    SyncBranch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company   SyncCompany?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([branchId, status])
  @@index([status])
  @@index([createdAt])
  @@map("sync_log")
}

model SyncSetting {
  id          String      @id @default(uuid())
  key         String
  value       String
  description String?
  companyId   String
  branchId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  scope       String      @default("GLOBAL")
  branch      SyncBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company     SyncCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, key])
  @@index([companyId])
  @@index([branchId])
  @@map("sync_setting")
}

model SyncBackup {
  id        String      @id @default(uuid())
  companyId String
  branchId  String?
  fileName  String
  notes     String?
  createdAt DateTime    @default(now())
  status    String      @default("SUCCESS")
  branch    SyncBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company   SyncCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
  @@map("sync_backup")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("notification")
}

model SyncDevice {
  id        String     @id @default(uuid())
  name      String
  type      String     @default("POS")
  status    String     @default("PENDING")
  branchId  String
  lastSeen  DateTime   @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branch    SyncBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("sync_device")
}

model SyncConflict {
  id         String    @id @default(uuid())
  syncLogId  String    @unique
  resolvedAt DateTime?
  resolution String?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  clientData Json?
  serverData Json?
  status     String    @default("PENDING")
  syncLog    SyncLog   @relation(fields: [syncLogId], references: [id], onDelete: Cascade)

  @@map("sync_conflict")
}

model SyncBackupSchedule {
  id        String   @id @default(uuid())
  name      String?
  branchId  String
  frequency String   // HOURLY, DAILY, WEEKLY
  time      String   // HH:mm
  keepDays  Int      @default(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    SyncBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("sync_backup_schedule")
}

model SyncAuditLog {
  id        String   @id @default(uuid())
  action    String
  module    String
  userId    String?
  branchId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([module])
  @@index([userId])
  @@index([branchId])
  @@map("sync_audit_log")
}

model SyncHealthMetric {
  id          String     @id @default(uuid())
  branchId    String
  latency     Float
  successRate Float
  uptime      Float
  timestamp   DateTime   @default(now())
  branch      SyncBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([timestamp])
  @@map("sync_health_metric")
}

enum InventoryAction {
  CREATE
  UPDATE
  SALE
  RESTOCK
  DELETE
  TRANSFER
  ADJUSTMENT
  STOCK_TAKE
  RETURN_FROM_CUSTOMER
  RETURN_TO_SUPPLIER
  WASTE_DAMAGED
}

enum AlertStatus {
  PENDING
  SEEN
  RESOLVED
}
