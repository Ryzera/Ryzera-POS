generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String         @id @default(uuid())
  username  String         @unique
  password  String
  role      String
  logs      InventoryLog[]
  createdAt DateTime       @default(now())
}

model Product {
  id            String         @id @default(uuid())
  name          String
  price         Float
  stockQty      Int            @default(0)
  inventoryLogs InventoryLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model InventoryLog {
  id          String   @id @default(uuid())
  action      String
  changeQty   Int
  description String?
  userId      String
  productId   String
  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
}

model SyncLog {
  id        String   @id @default(uuid())
  companyId String?
  branchId  String?
  entity    String
  status    String   @default("PENDING")
  payload   Json
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  syncedAt  DateTime?
  updatedAt DateTime @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  syncLogs  SyncLog[]
  settings  SystemSetting[]
  backups   BackupMetadata[]
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  name      String
  code      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  syncLogs  SyncLog[]
  settings  SystemSetting[]
  backups   BackupMetadata[]

  @@unique([companyId, code])
  @@index([companyId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String
  value       String
  description String?
  scope       String   @default("GLOBAL")
  companyId   String?
  branchId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company? @relation(fields: [companyId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])

  @@unique([companyId, branchId, key])
  @@index([companyId])
  @@index([branchId])
}

model BackupMetadata {
  id        String   @id @default(uuid())
  companyId String?
  branchId  String?
  status    String
  fileName  String?
  notes     String?
  createdAt DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([branchId])
}