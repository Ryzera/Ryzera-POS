generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

model Company {
  company_id   Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  email        String?
  phone        String?
  address      String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  branches     Branch[]
  users        User[]

  @@map("ryzera_pos_company")
}

model Branch {
  branchId   Int      @id @default(autoincrement())
  company_id  Int
  name        String
  code        String
  address     String?
  city        String?
  phone       String?
  email       String?
  manager_name String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company    Company   @relation(fields: [company_id], references: [company_id])
  users      User[]
  userLogs   UserLog[]

  @@map("ryzera_pos_branch")
}

model User {
  user_id       Int            @id @default(autoincrement())
  username      String         @unique
  password      String
  user_type     String    @default("STAFF")
  status        String
  company_id    Int
  branch_id     Int
  failed_login_attempts  Int       @default(0)
  last_failed_login      DateTime?
  account_locked_until   DateTime?
  last_login_at          DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  company       Company        @relation(fields: [company_id], references: [company_id])
  branch        Branch         @relation(fields: [branch_id], references: [branchId])
  info          UserInfo?
  userRoles     UserRole[]
  logs          UserLog[]
  inventoryLogs InventoryLog[]

  @@map("ryzera_pos_user")
}

model UserInfo {
  user_info_id Int      @id @default(autoincrement())
  user_id      Int      @unique
  first_name   String
  last_name    String
  email        String?  @unique
  phone        String?
  address      String?
  profile_pic  String?

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("ryzera_pos_user_info")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())

  userRoles       UserRole[]
  roleAuthorities RoleAuthority[]

  @@map("ryzera_pos_role")
}

model Authority {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())

  roleAuthorities RoleAuthority[]

  @@map("ryzera_pos_authority")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    Int
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("ryzera_pos_user_role")
}

model RoleAuthority {
  id          String     @id @default(uuid())
  roleId      String
  authorityId String
  createdAt   DateTime   @default(now())

  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  authority   Authority  @relation(fields: [authorityId], references: [id], onDelete: Cascade)

  @@unique([roleId, authorityId])
  @@map("ryzera_pos_role_authority")
}

model UserLog {
  id        String   @id @default(uuid())
  userId    Int
  branch_id Int
  action    String
  ipAddress String?
  device_info String?
  userAgent String?
  status    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branch_id], references: [branchId])

  @@map("ryzera_pos_user_log")
}

model Product {
  id            String         @id @default(uuid())
  name          String
  price         Float
  stockQty      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventoryLogs InventoryLog[]

  @@map("ryzera_pos_product")
}

model InventoryLog {
  id          String          @id @default(uuid())
  action      InventoryAction
  changeQty   Int
  description String?
  userId      Int
  productId   String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [user_id])
  product     Product  @relation(fields: [productId], references: [id])

  @@map("ryzera_pos_inventory_log")
}

model StockAlert {
  id       String      @id @default(uuid())
  status   AlertStatus @default(PENDING)
  stockQty Int
  minStock Int

  productId String
  product   Product @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())

  @@map("ryzera_pos_sync_log")
}


