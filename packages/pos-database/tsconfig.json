{
  "extends": "@ryzera/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "target": "ES2022",
    "module": "CommonJS",
    "strict": false,
    "esModuleInterop": true
  },
  "include": [
    "index.ts",
    "prisma.config.ts",
    "src/**/*.ts"]
}
