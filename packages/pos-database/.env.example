# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# Instructions:
# 1. Copy this file to .env (do not commit .env!)
# 2. Replace the placeholder values below with your actual database credentials
# 3. Make sure PostgreSQL is running on your machine
#
# Example:
# DATABASE_URL="postgresql://postgres:mypassword@localhost:5432/ryzera_db?schema=public"

DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/ryzera_db?schema=public"
